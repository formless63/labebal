  "link": {
    "templateId": "t-drawer-bin",
    "fields": {
      "title": "part",
      "spec": "spec",
      "code": "sku"
    },
    "keyColumn": "sku",
    "nameColumn": "part",
    "idPrefix": "l-drawer-bin-",
    "rules": {
      "mode": "all",
      "rules": [
        {
          "id": "rule-screws",
          "name": "Screws icon",
          "when": {
            "column": "category",
            "op": "equals",
            "value": "Screws"
          },
          "then": {
            "values": {
              "icon": "mdi:screw-machine-round-top"
            }
          }
        },
        {
          "id": "rule-nuts",
          "name": "Nuts icon",
          "when": {
            "column": "category",
            "op": "equals",
            "value": "Nuts"
          },
          "then": {
            "values": {
              "icon": "mdi:nut"
            }
          }
        },
        {
          "id": "rule-washers",
          "name": "Washers icon",
          "when": {
            "column": "category",
            "op": "equals",
            "value": "Washers"
          },
          "then": {
            "values": {
              "icon": "mdi:circle-double"
            }
          }
        },
        {
          "id": "rule-resistors",
          "name": "Resistors icon",
          "when": {
            "column": "category",
            "op": "equals",
            "value": "Resistors"
          },
          "then": {
            "values": {
              "icon": "circuit-resistor"
            }
          }
        },
        {
          "id": "rule-capacitors",
          "name": "Capacitors icon",
          "when": {
            "column": "category",
            "op": "equals",
            "value": "Capacitors"
          },
          "then": {
            "values": {
              "icon": "circuit-capacitor"
            }
          }
        },
        {
          "id": "rule-leds",
          "name": "LEDs icon",
          "when": {
            "column": "category",
            "op": "equals",
            "value": "LEDs"
          },
          "then": {
            "values": {
              "icon": "bulb"
            }
          }
        },
        {
          "id": "rule-connectors",
          "name": "Connectors icon",
          "when": {
            "column": "category",
            "op": "equals",
            "value": "Connectors"
          },
          "then": {
            "values": {
              "icon": "plug-connected"
            }
          }
        },
        {
          "id": "rule-ics",
          "name": "ICs icon",
          "when": {
            "column": "category",
            "op": "equals",
            "value": "ICs"
          },
          "then": {
            "values": {
              "icon": "mdi:integrated-circuit-chip"
            }
          }
        },
        {
          "id": "rule-electronics",
          "name": "Electronics: white icon on black",
          "when": {
            "column": "category",
            "op": "regex",
            "value": "^(resistors|capacitors|leds|ics)$"
          },
          "then": {
            "overrides": {
              "iconBox": {
                "fill": "black"
              },
              "icon": {
                "color": "white"
              }
            }
          }
        }
      ]
    }
  }
}
