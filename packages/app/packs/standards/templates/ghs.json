{
  "id": "t-std-ghs",
  "name": "Chemical container (GHS / OSHA HazCom)",
  "description": "Workplace / secondary container label with the GHS elements: product identifier, signal word, pictograms, hazard and precautionary statements, supplier. Pictograms are icon stand-ins drawn in black; containers shipped to others need the official red-bordered pictograms.",
  "schema": 2,
  "design": {
    "w": 101.6,
    "h": 76.2
  },
  "scaleText": true,
  "tags": [
    "standard",
    "safety",
    "chemical"
  ],
  "fields": [
    {
      "key": "product",
      "label": "Product name",
      "type": "text",
      "default": "Isopropyl alcohol 99%"
    },
    {
      "key": "signal",
      "label": "Signal word",
      "type": "text",
      "default": "Danger",
      "help": "Danger or Warning."
    },
    {
      "key": "pictograms",
      "label": "Pictograms",
      "type": "text",
      "default": "flame, irritant",
      "help": "Comma separated: flame, oxidiser, explosive, corrosive, gas, toxic, irritant, health, environment."
    },
    {
      "key": "hazards",
      "label": "Hazard statements",
      "type": "multiline",
      "default": "Highly flammable liquid and vapour.\nCauses serious eye irritation.\nMay cause drowsiness or dizziness."
    },
    {
      "key": "precautions",
      "label": "Precautionary statements",
      "type": "multiline",
      "default": "Keep away from heat, sparks and open flames. No smoking.\nWear eye protection. IF IN EYES: rinse cautiously with water for several minutes."
    },
    {
      "key": "supplier",
      "label": "Supplier",
      "type": "text",
      "default": "",
      "help": "Name, address and phone of the supplier. Empty: your Team values (company, address, phone)."
    }
  ],
