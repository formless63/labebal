  "rules": {
    "mode": "all",
    "rules": [
      {
        "id": "r7",
        "name": "Show Flammable only when listed",
        "when": {
          "column": "pictograms",
          "op": "contains",
          "value": "flame",
          "not": true
        },
        "then": {
          "overrides": {
            "ghs-flame": {
              "hidden": true
            }
          }
        }
      },
      {
        "id": "r8",
        "name": "Show Oxidiser (flame over circle) only when listed",
        "when": {
          "column": "pictograms",
          "op": "contains",
          "value": "oxidiser",
          "not": true
        },
        "then": {
          "overrides": {
            "ghs-oxidiser": {
              "hidden": true
            }
          }
        }
      },
      {
        "id": "r9",
        "name": "Show Explosive (exploding bomb) only when listed",
