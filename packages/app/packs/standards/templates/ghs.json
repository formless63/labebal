      {
        "id": "r16",
        "name": "No supplier: use Team values",
        "when": {
          "column": "supplier",
          "op": "isEmpty"
        },
        "then": {
          "overrides": {
            "supplier": {
              "text": "{{team:company}} · {{team:address}} · {{team:phone}}"
            }
          }
        }
