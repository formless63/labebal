{
  "id": "t-std-z535",
  "name": "Safety label (ANSI Z535.4 style)",
  "description": "Product safety label: signal-word panel (DANGER, WARNING, CAUTION, NOTICE), a symbol panel and the message. Follows the Z535.4 layout in black and white; NOTICE drops the safety alert symbol. Check compliance against the standard.",
  "schema": 2,
  "design": {
    "w": 100,
    "h": 50
  },
  "scaleText": true,
  "tags": [
    "standard",
    "safety"
  ],
  "fields": [
    {
      "key": "signal",
      "label": "Signal word",
      "type": "text",
      "default": "WARNING",
      "help": "DANGER, WARNING, CAUTION or NOTICE."
    },
    {
      "key": "message",
      "label": "Message",
      "type": "multiline",
      "default": "Hot surface.\nContact may cause burns.\nAllow to cool before servicing.",
      "help": "What the hazard is, what happens, how to avoid it."
    },
    {
      "key": "symbol",
      "label": "Symbol (icon)",
      "type": "text",
      "default": "mdi:fire",
      "help": "Any icon id, e.g. mdi:fire, mdi:hand-back-right-off, mdi:lightning-bolt, mdi:safety-goggles. Empty: no symbol panel."
    }
  ],
  "root": {
    "id": "root",
    "name": "Label",
    "type": "frame",
    "layout": "column",
    "w": {
      "kind": "fill"
    },
    "h": {
      "kind": "fill"
    },
    "align": "stretch",
    "stroke": "black",
    "strokeMm": 0.6,
    "children": [
      {
        "id": "signalPanel",
        "name": "Signal word panel",
        "type": "frame",
        "layout": "row",
        "w": {
          "kind": "fill"
        },
        "h": {
          "kind": "fill",
          "weight": 1
        },
        "padding": [
          0.8,
          2,
          0.8,
          2
        ],
        "gap": 1.5,
        "align": "stretch",
        "justify": "center",
        "fill": "black",
        "children": [
          {
            "id": "signalPanelAlert",
            "name": "Safety alert symbol",
            "type": "icon",
            "icon": "alert-triangle",
            "filled": true,
            "color": "white",
            "w": {
              "kind": "hug"
            },
            "h": {
              "kind": "fill"
            }
          },
          {
            "id": "signalPanelWord",
            "name": "Signal word",
            "type": "text",
            "text": "{{signal}}",
            "font": "Atkinson Hyperlegible Next",
            "weight": 800,
            "sizePt": 22,
            "minSizePt": 3.5,
            "fit": "shrink",
            "align": "left",
            "valign": "middle",
            "uppercase": true,
            "letterSpacing": 0.1,
            "color": "white",
            "w": {
              "kind": "hug"
            },
            "h": {
              "kind": "fill"
            }
          }
        ]
      },
      {
        "id": "body",
        "name": "body",
        "type": "frame",
        "layout": "row",
        "w": {
          "kind": "fill"
        },
        "h": {
          "kind": "fill",
          "weight": 2.6
        },
        "padding": [
          1.5,
          1.5,
          1.5,
          1.5
        ],
        "gap": 2,
        "align": "stretch",
        "children": [
          {
            "id": "symbolBox",
            "name": "Symbol panel",
            "type": "frame",
            "layout": "row",
            "w": {
              "kind": "pct",
              "pct": 30
            },
            "h": {
              "kind": "fill"
            },
            "padding": [
              1.5,
              1.5,
              1.5,
              1.5
            ],
            "align": "stretch",
            "justify": "center",
            "stroke": "black",
            "strokeMm": 0.5,
            "children": [
              {
                "id": "symbolIcon",
                "name": "Symbol",
                "type": "icon",
                "icon": "{{symbol}}",
                "color": "black",
                "w": {
                  "kind": "fill"
                },
                "h": {
                  "kind": "fill"
                }
              }
            ]
          },
          {
            "id": "message",
            "name": "message",
            "type": "text",
            "text": "{{message}}",
            "font": "Atkinson Hyperlegible Next",
            "weight": 800,
            "sizePt": 11,
            "minSizePt": 3.5,
            "fit": "shrink",
            "align": "left",
            "valign": "middle",
            "lineHeight": 1.15,
            "color": "black",
            "w": {
              "kind": "fill"
            },
            "h": {
              "kind": "fill"
            }
          }
        ]
      }
    ]
  },
  "rules": {
    "mode": "all",
    "rules": [
      {
        "id": "r3",
        "name": "NOTICE has no safety alert symbol",
        "when": {
          "column": "signal",
          "op": "equals",
          "value": "NOTICE"
        },
        "then": {
          "overrides": {
            "signalPanelAlert": {
              "hidden": true
            }
          }
        }
      },
      {
        "id": "r4",
        "name": "Hide symbolBox when symbol is empty",
        "when": {
          "column": "symbol",
          "op": "isEmpty"
        },
        "then": {
          "overrides": {
            "symbolBox": {
              "hidden": true
            }
          }
        }
      }
    ]
  }
}
