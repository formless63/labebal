  "rules": {
    "mode": "all",
    "rules": [
      {
        "id": "r1",
        "name": "No batch: best-before only",
        "when": {
          "column": "batch",
          "op": "isEmpty"
        },
        "then": {
          "overrides": {
            "bc2": {
              "value": "(15){{bestBefore|date:YYMMDD}}"
            },
            "batchBox": {
              "hidden": true
            },
            "d2Split": {
              "hidden": true
            }
          }
        }
      },
      {
        "id": "r2",
        "name": "No best-before: batch only",
        "when": {
          "column": "bestBefore",
          "op": "isEmpty"
        },
        "then": {
          "overrides": {
            "bc2": {
              "value": "(10){{batch}}"
            },
            "bbBox": {
              "hidden": true
            },
            "d2Split": {
              "hidden": true
            }
          }
        }
      }
    ]
  }
