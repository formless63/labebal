{
  "id": "t-std-gs1-logistic",
  "name": "GS1 logistic label (SSCC)",
  "description": "Pallet / carton shipping label after the GS1 Logistic Label guideline: from and to, SSCC, content GTIN, count, batch and best-before, with GS1-128 barcodes. 4 x 6 in. Sender comes from Team values (company, address).",
  "schema": 2,
  "design": {
    "w": 101.6,
    "h": 152.4
  },
  "scaleText": true,
  "tags": [
    "standard",
    "shipping",
    "gs1"
  ],
  "fields": [
    {
      "key": "to",
      "label": "Ship to",
      "type": "multiline",
      "default": "Customer name\n1 Delivery Road\nTown, ST 12345"
    },
    {
      "key": "sscc",
      "label": "SSCC (17 digits)",
      "type": "text",
      "default": "00012345600000001",
      "help": "Extension digit, GS1 company prefix and serial; the check digit is added. Use a counter: {{counter:sscc:00012345600000000}}."
    },
    {
      "key": "gtin",
      "label": "Content GTIN (13 digits)",
      "type": "text",
      "default": "0952123454321",
      "help": "The trade item inside; the check digit is added."
    },
    {
      "key": "count",
      "label": "Count",
      "type": "text",
      "default": "24"
    },
    {
      "key": "batch",
      "label": "Batch / lot",
      "type": "text",
      "default": "LOT42"
    },
    {
      "key": "bestBefore",
      "label": "Best before",
      "type": "text",
      "default": "2027-06-30",
      "help": "A date (any format); printed as YYMMDD in the barcode."
    }
  ],
