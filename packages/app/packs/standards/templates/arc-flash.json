  "rules": {
    "mode": "all",
    "rules": [
      {
        "id": "r5",
        "name": "Hide rLimited when limited is empty",
        "when": {
          "column": "limited",
          "op": "isEmpty"
        },
        "then": {
          "overrides": {
            "rLimited": {
              "hidden": true
            }
          }
        }
      },
      {
        "id": "r6",
        "name": "Hide rRestricted when restricted is empty",
        "when": {
          "column": "restricted",
          "op": "isEmpty"
        },
        "then": {
          "overrides": {
            "rRestricted": {
              "hidden": true
            }
          }
        }
      }
    ]
