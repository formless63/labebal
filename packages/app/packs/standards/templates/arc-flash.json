{
  "id": "t-std-arc-flash",
  "name": "Arc flash label (NFPA 70E)",
  "description": "Equipment arc flash and shock label with the fields NFPA 70E 130.5(H) asks for: nominal voltage, arc flash boundary, incident energy and working distance or PPE category, shock approach boundaries, date of the study. 4 x 3 in.",
  "schema": 2,
  "design": {
    "w": 101.6,
    "h": 76.2
  },
  "scaleText": true,
  "tags": [
    "standard",
    "safety",
    "electrical"
  ],
  "fields": [
    {
      "key": "signal",
      "label": "Signal word",
      "type": "text",
      "default": "WARNING",
      "help": "WARNING, or DANGER above 40 cal/cm²."
    },
    {
      "key": "voltage",
      "label": "Nominal voltage",
      "type": "text",
      "default": "480 VAC"
    },
    {
      "key": "boundary",
      "label": "Arc flash boundary",
      "type": "text",
      "default": "1.2 m (47 in)"
    },
    {
      "key": "energy",
      "label": "Incident energy",
      "type": "text",
      "default": "8.0 cal/cm² at 455 mm (18 in)"
    },
    {
      "key": "ppe",
      "label": "PPE category / clothing",
      "type": "text",
      "default": "Category 2 · arc rated 8 cal/cm²"
    },
    {
      "key": "limited",
      "label": "Limited approach",
      "type": "text",
      "default": "1.07 m (3 ft 6 in)"
    },
    {
      "key": "restricted",
      "label": "Restricted approach",
      "type": "text",
      "default": "0.3 m (1 ft)"
    },
    {
      "key": "equipment",
      "label": "Equipment",
      "type": "text",
      "default": "MCC-2 · Bucket 3A"
    },
    {
      "key": "studyDate",
      "label": "Study date",
      "type": "text",
      "default": "2026-11-21"
    }
  ],
