{
  "id": "t-std-eigp114",
  "name": "Component reel / bag (ECIA EIGP 114)",
  "description": "Electronic component packaging label: readable part numbers, quantity, date code, lot and country of origin, and the ECIA 2D symbol (Data Matrix, ANSI MH10.8.2 format 06 with data identifiers P, 1P, K, Q, 10D, 1T, 4L). 4 x 2 in.",
  "schema": 2,
  "design": {
    "w": 101.6,
    "h": 50.8
  },
  "scaleText": true,
  "tags": [
    "standard",
    "electronics",
    "parts"
  ],
  "fields": [
    {
      "key": "custPart",
      "label": "Customer part number (P)",
      "type": "text",
      "default": "R-10K-0603"
    },
    {
      "key": "mfrPart",
      "label": "Manufacturer part number (1P)",
      "type": "text",
      "default": "RC0603FR-0710KL"
    },
    {
      "key": "po",
      "label": "PO number (K)",
      "type": "text",
      "default": "PO-1042"
    },
    {
      "key": "qty",
      "label": "Quantity (Q)",
      "type": "text",
      "default": "5000"
    },
    {
      "key": "dateCode",
      "label": "Date code (10D, YYWW)",
      "type": "text",
      "default": "2647"
    },
    {
      "key": "lot",
      "label": "Lot (1T)",
      "type": "text",
      "default": "LOT42"
    },
    {
      "key": "coo",
      "label": "Country of origin (4L)",
      "type": "text",
      "default": "TW",
      "help": "Two-letter country code."
    },
    {
      "key": "description",
      "label": "Description",
      "type": "text",
      "default": "Resistor 10 kΩ 1% 0603"
    }
  ],
