{
  "name": "@labebal/app",
  "version": "0.1.0",
  "private": true,
  "description": "labebal as a module: label designer and Niimbot printing screens (React) plus a fetch-standard server handler (Postgres).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/client.tsx",
    "./server": "./src/server.ts",
    "./schema": "./src/db/schema.ts",
    "./tailwind.css": "./styles/tailwind.css",
    "./theme.css": "./styles/theme.css",
    "./package.json": "./package.json",
    "./styles.css": "./styles/labebal.css"
  },
  "files": [
    "src",
    "drizzle",
    "assets",
    "packs",
    "styles"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "gen:routes": "node scripts/gen-routes.mjs",
    "db:generate": "drizzle-kit generate",
    "build:css": "node scripts/build-css.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify/types": "^2.0.0",
    "@tabler/icons": "^3.52.0",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@labebal/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.74.0",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
