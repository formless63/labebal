{
  "name": "@labebal/app",
  "version": "0.1.0",
  "description": "labebal as a module: label designer and printing screens (React) plus a fetch-standard server handler (Postgres).",
  "keywords": [
    "label",
    "label-designer",
    "label-printer",
    "niimbot",
    "zpl",
    "react",
    "drizzle",
    "postgres"
  ],
  "license": "MIT",
  "author": "formless63",
  "homepage": "https://formless63.github.io/labebal/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formless63/labebal.git",
    "directory": "packages/app"
  },
  "bugs": "https://github.com/formless63/labebal/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/client.tsx",
    "./server": "./src/server.ts",
    "./schema": "./src/db/schema.ts",
    "./tailwind.css": "./styles/tailwind.css",
    "./theme.css": "./styles/theme.css",
    "./package.json": "./package.json",
    "./styles.css": "./styles/labebal.css",
    "./vendor/xlsx": "./src/vendor/xlsx.ts"
  },
  "files": [
    "dist",
    "drizzle",
    "assets",
    "packs",
    "styles"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./schema": {
        "types": "./dist/db/schema.d.ts",
        "default": "./dist/db/schema.js"
      },
      "./vendor/xlsx": "./dist/vendor/xlsx.js",
      "./tailwind.css": "./styles/tailwind.css",
      "./theme.css": "./styles/theme.css",
      "./styles.css": "./styles/labebal.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs && node -e \"fs.copyFileSync('node_modules/xlsx/LICENSE','dist/vendor/xlsx.LICENSE.txt')\"",
    "prepack": "pnpm build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "gen:routes": "node scripts/gen-routes.mjs",
    "db:generate": "drizzle-kit generate",
    "build:css": "node scripts/build-css.mjs"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify/types": "^2.0.0",
    "@labebal/core": "workspace:*",
    "@tabler/icons": "^3.52.0",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.0",
    "postcss": "^8.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rolldown": "1.2.19",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
